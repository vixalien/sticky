@import 'util.styl';

colors = {
  yellow: {
    header: #ffee92,
    bg: #fff6cb,
    ink: #000,
    fg: #000,
    link: #3f00ff,
    hc: #ffdb28,

    // keep yellow notes bright (like real paper sticky notes) even in
    // dark style; the previous dark variant (#7c7348) read as olive/army green
    bg_dark: #fff6cb,
    fg_dark: #000,
    header_dark: #ffee92

  },
  pink: {
    header: #ffc5e1,
    bg: #ffe3f1,
    ink: #007041,
    fg: #000,
    link: #3f00ff,
    hc: #ff1988,

    // respect the user's chosen color in dark style too
    bg_dark: #ffe3f1,
    fg_dark: #000,
    header_dark: #ffc5e1
  },
  green: {
    header: #d1ebcb,
    bg: #e7f6e4,
    ink: #8907c8,
    fg: #000,
    link: #3f00ff,
    hc: #50ff2d,

    bg_dark: #e7f6e4,
    fg_dark: #000,
    header_dark: #d1ebcb
  },
  purple: {
    header: #e2d0f5,
    bg: #f2e5ff,
    ink: #016681,
    fg: #000,
    link: #3f00ff,
    hc: #9123ff,

    bg_dark: #f2e5ff,
    fg_dark: #000,
    header_dark: #e2d0f5
  },
  blue: {
    header: #cce7ff,
    bg: #e7f3ff,
    ink: #f14e00,
    fg: #000,
    link: #3f00ff,
    hc: #239fff,

    bg_dark: #e7f3ff,
    fg_dark: #000,
    header_dark: #cce7ff
  },
  gray: {
    header: #dddad8,
    bg: #edebe9,
    ink: #302821,
    fg: #000,
    link: #3f00ff,
    hc: #e5e5e5,

    bg_dark: #edebe9,
    fg_dark: #000,
    header_dark: #dddad8
  },
  charcoal: {
    header: #3f3d3c,
    bg: #5e5e5e,
    ink: #fff,
    fg: #fff,
    link: #b4faff,
    hc: #6d6d6d,

    bg_dark: #5e5e5e,
    fg_dark: #fff,
    header_dark: #3f3d3c
  },
  window: {
    header: at(headerbar_bg_color),
    bg: at(window_bg_color),
    ink: at(window_fg_color),
    fg: at(window_fg_color),
    link: at(accent_bg_color),
    hc: at(window_fg_color)

    bg_dark: at(window_bg_color),
    fg_dark: at(window_fg_color),
    header_dark: at(headerbar_bg_color)
  }
};